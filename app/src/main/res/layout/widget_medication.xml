<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/Theme.PillReminder">

    <!-- Next Dose Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coming Up"
        android:textColor="#8D6E63"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text_next_dose_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="10:30 AM"
        android:textColor="#4E342E"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_next_dose_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Multivitamin • 1 capsule"
        android:textColor="#4E342E"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#1F4E342E" />

    <!-- Progress Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_progress_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2/4"
                android:textColor="#FF7043"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done Today"
                android:textColor="#8D6E63"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:text="Current Status"
                android:textColor="#8D6E63"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_progress_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feeling Great!"
                android:textColor="#4E342E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
